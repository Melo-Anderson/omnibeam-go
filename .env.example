# ==============================================================================
# Omnibeam Dataflow Compute Engine — Environment Configuration (.env.example)
# ==============================================================================
# Copie este arquivo para .env ou exporte as variáveis no seu shell/IDE.

# --- Go Runtime ---
GOTMPDIR=.gotmp

# --- OpenTelemetry & Jaeger Tracing ---
# Local host development (Jaeger in Docker Compose): localhost:4317
# Inside docker container network: jaeger:4317
# GCP Dataflow: Cloud Trace exporter / OpenTelemetry Collector
OTEL_EXPORTER_OTLP_ENDPOINT=localhost:4317

# --- Google Cloud Storage (Local Emulator vs GCP) ---
# Para desenvolvimento local usando o emulador Fake-GCS-Server:
STORAGE_EMULATOR_HOST=127.0.0.1:4443
# Para produção na GCP (comentar a linha STORAGE_EMULATOR_HOST e definir GCP ADC):
# GCP_PROJECT_ID=seu-projeto-gcp
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/sa-key.json

# --- OpenBao / HashiCorp Vault Secrets ---
BAO_ADDR=http://127.0.0.1:8200
BAO_DEV_ROOT_TOKEN_ID=testtoken

# --- Relational Database Local Test Endpoints & Connection URIs ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=testdb
POSTGRES_USER=testuser
POSTGRES_PASSWORD=testpassword
POSTGRES_CONNECTION_URI=postgres://testuser:testpassword@localhost:5432/testdb?sslmode=disable

MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DB=testdb
MYSQL_USER=testuser
MYSQL_PASSWORD=testpassword
MYSQL_CONNECTION_URI=testuser:testpassword@tcp(127.0.0.1:3306)/testdb?parseTime=true
