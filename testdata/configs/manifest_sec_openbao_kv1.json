{
  "pipeline_id": "e2e-sec-03-openbao-kv1",
  "run_id": "run-sec-003",
  "pipeline_type": "sql",
  "secrets_config": {
    "provider": "openbao",
    "vault_url": "http://127.0.0.1:8200",
    "vault_token": "testtoken",
    "host_override": {
      "mysql": "localhost"
    }
  },
  "database_source": {
    "driver": "mysql",
    "connection_uri": "testuser:{{password}}@tcp(mysql:3306)/testdb?parseTime=true",
    "password_ref": "openbao:kv1/mysql#password",
    "table": "products_mixed",
    "partition_config": {
      "partition_column": "id",
      "batch_size": 2500
    },
    "schema": {
      "fields": [
        {"name": "id", "type": "int64", "nullable": false},
        {"name": "name", "type": "string", "nullable": false},
        {"name": "price", "type": "float64", "nullable": false},
        {"name": "in_stock", "type": "bool", "nullable": false},
        {"name": "description", "type": "string", "nullable": true},
        {"name": "created_at", "type": "timestamp", "nullable": false}
      ]
    }
  },
  "destination": {
    "type": "local_storage",
    "output_format": "parquet",
    "output_path": "testdata/output/e2e_sec_03/products.parquet",
    "compression": "snappy"
  },
  "dlq_config": {
    "enabled": true,
    "quarantine_path": "testdata/output/e2e_sec_03/dlq.jsonl"
  }
}
